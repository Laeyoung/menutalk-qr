    "demo:make": "node --env-file-if-exists=.env.local scripts/make-demo-menu.mjs",
    "demo:pregen": "node --env-file-if-exists=.env.local scripts/pregen-audio.mjs",
    "demo:samples": "node --env-file-if-exists=.env.local scripts/gen-samples.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "next": "16.4.5",
    "openai": "7.50.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
